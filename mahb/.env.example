# ── Google Sheets (메타데이터 DB) ──
# 서비스 계정 이메일 / 프라이빗 키 (Google Cloud Console > IAM > 서비스 계정 키 발급)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 시트를 서비스 계정 이메일에 "편집자"로 공유해야 함
GOOGLE_SHEET_ID=

# ── Telegram 알림 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
