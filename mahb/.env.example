# ── Google Sheets (메타데이터 DB) ──
# 서비스 계정 이메일 / 프라이빗 키 (Google Cloud Console > IAM > 서비스 계정 키 발급)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 시트를 서비스 계정 이메일에 "편집자"로 공유해야 함
GOOGLE_SHEET_ID=

# ── Google Drive 폴더 실시간 스캔 (Sheets 없이도 사진만 올리면 자동 반영) ──
# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY 는 위와 동일한 값 사용
# 폴더도 서비스 계정 이메일에 "뷰어"로 공유하거나 "링크가 있는 모든 사용자"로 공개
GOOGLE_DRIVE_FOLDER_ID=1-AwVQpXFYo_JqKWFvVmIwR1_0BE7hCCj

# ── Telegram 알림 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
