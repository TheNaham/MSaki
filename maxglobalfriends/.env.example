# ── 사이트 비밀번호 (미설정 시 기본값 8687 사용) ──
SITE_PASSWORD=

# ── Google Sheets (연결 기록 DB) ──
# 서비스 계정 이메일 / 프라이빗 키 (Google Cloud Console > IAM > 서비스 계정 키 발급)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 시트를 서비스 계정 이메일에 "뷰어"로 공유해도 충분함 (읽기 전용)
GOOGLE_SHEET_ID=
